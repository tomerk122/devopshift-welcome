@Library('my-shared-library') _ 
pipeline {
    agent any

    environment {
        APP_ENV = 'production'
        APP_DEBUG = 'true'
        DEBUG_BRANCH = 'develop'
    }

    stages {
        stage('Check if Gal is a good brother') {
            steps {
                script {
                    // Ask if Gal is a good brother
                    def isGoodBrother = input(message: 'Is Gal a good brother?', parameters: [choice(name: 'Yes or No', choices: ['Yes', 'No'], description: 'Please confirm if Gal is a good brother.')])

                    // If the answer is 'No', proceed to the next stage
                    if (isGoodBrother == 'No') {
                        currentBuild.result = 'SUCCESS' // Continue pipeline and mark successful stage
                        echo 'You are the king!' // Print message
                    } else {
                        echo 'Gal is a good brother!'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    // Call the mock buildApp function
                    first.buildApp()
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // If APP_DEBUG is set to 'true' set env.BRANCH_NAME to DEBUG_BRANCH
                    env.BRANCH_NAME = env.APP_DEBUG == 'true' ? env.DEBUG_BRANCH : env.BRANCH_NAME
                    // Call the mock deployApp function with the current branch name
                    first.deployApp(env.BRANCH_NAME)
                }
            }
        }

        stage('CLEAN') {
            steps {
                script {
                    // Ask the user if they want to proceed with the cleanup
                    def userResponse = input(message: 'Do you want to clean up everything?', parameters: [choice(name: 'Confirmation', choices: ['Yes', 'No'], description: 'Confirm whether to clean up everything.')])
                    if (userResponse == 'Yes') {
                        // Call the cleanup function if the user confirms
                        first.cleanup()
                    } else {
                        echo 'Cleanup cancelled.'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Call the mock cleanup function if not already done in the CLEAN stage
                if (env.BRANCH_NAME != 'cleanup') {
                    first.cleanup()
                }
            }
        }
    }
}
