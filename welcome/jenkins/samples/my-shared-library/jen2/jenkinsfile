''''
ab Instructions
1. Setup the Pipeline Structure
Create a Scripted Pipeline that includes the following stages:
Clone: Fetch the repository from GitHub (mock this step with a simple echo command).
Build: Mock the build step (e.g., echo "Building Python project...").
Parallel Tasks:
Lint: Mock linting (e.g., echo "Running Python linting...").
Security Test: Mock security analysis (e.g., echo "Running security tests...").
Deploy (Optional): Add a user input step to determine if deployment should proceed. If yes, mock a deployment step (e.g., echo "Deploying to production...").

runStage(stageName, command): Takes a stage name and a command to run, printing the stage name and executing the command.
parallelSteps(): Defines the parallel lint and security testing steps.
'''
def runStage(stageName,command){  
    stage('run-stage'){ 
    echo "Im running ${stageName} stage"
    echo "Im running ${command} command"
    }
}
def runStagee = { stageName, command ->
    stage(stageName) {   // יוצר את השלב עם השם שנתנו
        echo "Starting stage: ${stageName}"
        sh command       // מריץ את הפקודה
    }
}
def parallelSteps(){
    stage('Parallel Tasks'){
        parallel(
            'Lint':{
                echo 'Running Python linting...'
            },
            'Security Test':{
                echo 'Running security tests...'
            }
        )
    }
}
node{ 
    runStagee('Clone', 'echo "Cloning repository..."')
    stage('Build'){
        echo 'Building Python project...'
    }
    script{
        parallelSteps()
    }
   stage('Deploy') {
        def userInput = input message: 'Do you want to deploy?', parameters: [choice(name: 'Deploy?', choices: ['Yes', 'No'], description: 'Choose whether to deploy')]
        
        // אם התשובה היא "Yes", תמשיך לפעולה של פריסה
        if (userInput == 'Yes') {
            echo 'Deploying to production...'
            script {
                runStage('Deploy', 'echo "Deploying to production..."')
            }
        } else {
            echo 'Deployment skipped.'
        }
    }
}