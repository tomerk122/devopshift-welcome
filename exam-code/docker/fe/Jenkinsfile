/*

*/

pipeline {
    agent any
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'tomertest123'
        REPO_NAME = 'fe-exam'  // Change to 'be-exam' for backend pipeline
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        
    }
    stages {
        stage('Clone Repository') { // clone the repository
            steps {
                git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/tomerk122/devopshift-welcome.git'
            }
        } // end of clone repository
        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        // sh 'pip install flake8'
                         sh 'flake8 . || true'
                     
                    }
                }
                stage('Bandit Security Scan') {
                    steps {
                        // sh 'pip install bandit'
                        sh 'bandit -r . || true'

                    }
                }
            }
        } // end of lint & security scan
        stage('Install Dependencies') { // Install dependencies based on repo name
                steps {
                    script {
                        if (env.REPO_NAME == 'fe-exam') {
                            dir('exam-code/docker/fe') {
                                sh 'pwd'
                                sh 'pip install -r requirements.txt'
                            }
                        } else {
                            dir('exam-code/docker/be') { 
                                sh 'pwd'
                                sh 'pip install -r requirements.txt'
                            }
                        }
                    }
                }
            } // end of install dependencies
        stage('Build Docker Image'){
                steps {
                    script {
                        if (env.REPO_NAME == 'fe-exam') {
                            dir('exam-code/docker/fe') {
                                sh 'docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} .'
                                sh 'docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${REPO_NAME}:latest'
                            }
                        } else {
                            dir('exam-code/docker/be') {
                                sh 'docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} .'
                                sh 'docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${REPO_NAME}:latest'
                            }
                        }
                    }
                }
            } // end of build docker image
    stage('Run Tests in Container'){
        steps{
           sh 'docker images'
            sh 'docker run --rm ${DOCKER_REGISTRY}/${REPO_NAME}:${BUILD_NUMBER} pytest tests/'
        }
    }
    stage('Install Docker Compose') {
            steps {
                script {
                    // Checking if docker-compose is already installed
                    sh '''
                    if ! command -v docker-compose &> /dev/null
                    then
                        echo "Docker Compose could not be found, installing..."
                         curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                         chmod +x /usr/local/bin/docker-compose
                    else
                        echo "Docker Compose is already installed."
                    fi
                    '''
                }
            }
        } // end of Install Docker Compose
    stage('Integration Test with Docker Compose'){
        steps{
             dir('exam-code/docker/fe'){
            sh 'docker-compose up -d'
            sh 'sleep 10'
            sh 'curl -f http://localhost:5002 || true'
            sh 'docker-compose down'
             }
        }
    } // end of integration
    stage(' Push to Docker Hub'){
        steps{
            
            withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'DOCKERHUB_CREDENTIALS_USR', passwordVariable: 'DOCKERHUB_CREDENTIALS_PSW')]) {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG}'
                sh 'docker push ${DOCKER_REGISTRY}/${REPO_NAME}:latest'
            }
        }
    } // end of push to docker hub
}   // end of stages
}
        
        
